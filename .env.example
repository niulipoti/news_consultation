# ============================================================
# 复制这份文件为 .env 后填入真实值即可（.env 不会被提交到 Git）
# ============================================================

# ---------- AI 对话（DeepSeek，兼容 OpenAI 协议） ----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填写你自己的DeepSeek密钥
# 可选：OpenAI 兼容地址（换成自建网关时修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：默认模型（deepseek-chat / deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat
# 可选：是否强制使用流式输出（true / false）
AI_STREAM=true
# 可选：单条消息最大长度
AI_MAX_MESSAGE_LENGTH=4000
# 可选：最多携带多少轮历史消息
AI_MAX_HISTORY_LENGTH=20

# ---------- MySQL 数据库 ----------
# 格式：mysql+aiomysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/news_app?charset=utf8mb4
# 是否打印 SQL 语句（调试用，生产建议 false）
SQL_ECHO=false

# ---------- Redis 缓存 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 本地没装 Redis 时设为 false，接口会自动跳过缓存直接查库
REDIS_ENABLED=true

# ---------- 跨域 ----------
# 生产环境填写前端的真实域名，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
